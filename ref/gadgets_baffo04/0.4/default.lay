    <group name="secret_conditions_panel">
		<element id="secret_conditions_gadget" ref="secret_conditions_gadget">
            <bounds x="0" y="0" width="246" height="613" />
		</element>
        <repeat count="12">
            <param name="i" start="0" increment="1" />
            <param name="y" start="123" increment="39" />
            <element id="condition_checkbox_~i~" ref="checkbox">
                <bounds x="197" y="~y~" width="23" height="23" />
            </element>
        </repeat>
    </group>
    
